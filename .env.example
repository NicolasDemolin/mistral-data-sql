# ==============================================================================
# ACPR Mistral AI Studio - Exemple de Variables d'Environnement
# ==============================================================================

# Copiez ce fichier vers .env et renseignez votre clé MISTRAL_API_KEY
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_AGENT_ID=your_registered_agent_id_here

# Modèles Mistral AI Studio
MISTRAL_MODEL_LARGE=mistral-large-latest
MISTRAL_MODEL_MEDIUM=mistral-medium-latest
MISTRAL_MODEL_CODE=codestral-latest
MISTRAL_MODEL_EMBED=mistral-embed

# Serveur Web Studio
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Base de données & Paramètres
DATABASE_PATH=acpr_reporting.db
DEFAULT_CURRENCY=EUR
DEFAULT_PERIOD=2023-Q4
